# ===== 必填 =====

# 对外访问的 https 地址，结尾不带斜杠。
# Telegram Webhook、发给 Crisp 的图片地址都用它拼，必须是公网能访问到的
PUBLIC_URL=https://crispai.example.com

# 管理后台的登录账号密码（浏览器 Basic 认证）。务必只通过 https 访问
ADMIN_USER=admin
ADMIN_PASSWORD=

# Crisp 插件（https://marketplace.crisp.chat 里创建一个私有插件）
# CRISP_ID / CRISP_KEY：插件的 Token Identifier / Key（用 Production token）
# CRISP_SECRET：插件 Web Hooks 的签名密钥
# CRISP_URN：插件的 URN，形如 urn:your.name:pluginname:0
CRISP_ID=
CRISP_KEY=
CRISP_SECRET=
CRISP_URN=

# Telegram 机器人 token（@BotFather 创建）
TELEGRAM_TOKEN=

# OpenAI 或任何兼容接口
OPENAI_URL=https://api.openai.com/v1
OPENAI_KEY=

# ===== 选填 =====

# 对话模型
# OPENAI_MODEL=gpt-4.1-nano
# 向量模型，输出必须是 1536 维
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 宿主机端口
# PORT=3000
# 宿主机监听地址。默认 127.0.0.1（只有本机的反向代理能访问）。
# 反向代理在另一台机器上时才需要改成 0.0.0.0，并自行用防火墙限制来源
# BIND_ADDRESS=127.0.0.1
# 登录失败限流按来源 IP 计数。在反向代理后面时，建议设为 true，让它读取代理传来的
# X-Forwarded-For 区分真实来源；前提是代理会追加或覆盖这个头，否则来源可以被伪造。
# Caddy、Traefik 默认满足；Nginx 默认原样转发，必须自己加一行（见 README「反向代理」）。
# 不设置时所有访问者共用一个较宽松的计数
# TRUST_PROXY=false
# 数据库密码（只在 compose 内部网络可见）。首次启动后再改不会生效
# POSTGRES_PASSWORD=crispai
# LOG_LEVEL=info

# 允许服务器下载访客语音的域名，逗号分隔；以 "." 开头表示包含所有子域名。
# 默认只允许 Crisp 自己的存储（.crisp.chat），一般不用改
# MEDIA_ALLOWED_HOSTS=.crisp.chat
# 欢迎语接口每个站点每分钟最多受理的次数（防刷），默认 300
# INTRO_RATE_LIMIT=300
# 每个会话每 10 分钟最多触发多少次 AI 回复（防止访客刷爆 OpenAI 额度），默认 30，0 表示不限制
# AI_SESSION_RATE_LIMIT=30
# Crisp Webhook 时间戳允许的最大时间差（秒），默认 86400，0 表示不检查
# CRISP_WEBHOOK_MAX_AGE=86400
# Telegram 发出的图片在服务器上保留多少天。默认 0 = 永不清理。
# 设置天数后每天清理一次超期文件；清理后 Crisp 历史记录里对应的旧图片将无法显示
# UPLOAD_RETENTION_DAYS=0
# 设为 true 后，只有群主/管理员能回复客户、切换在线状态和屏蔽；默认群内所有成员都可以
# TELEGRAM_ADMIN_ONLY=false

# ===== MCP（给 Hermes 等 AI 助手调用，可选） =====
# 配置后开启 https://你的域名/mcp，助手用它批量查看会话、批量回复客户。
# 这是一把能直接给客户发消息的钥匙：至少 24 个字符，用随机串（如 openssl rand -hex 32），不要和后台密码相同
# MCP_TOKEN=
# 设为 true 后助手只能查看，不能回复
# MCP_READONLY=false
# 助手的回复同步到 Telegram 客服群时显示的名字
# MCP_AGENT_NAME=Hermes
